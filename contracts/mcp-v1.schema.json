{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prismteam.ai/oracle/mcp/v1/schema.json",
  "title": "Prism Oracle MCP v1 contract fixtures",
  "description": "Normative schemas for the structured MCP v1 tool inputs, outputs, evidence, pagination and partial-data behavior. The document root validates committed contract fixtures; the $defs are the runtime contract.",
  "oneOf": [
    { "$ref": "#/$defs/SearchRequestFixture" },
    { "$ref": "#/$defs/SearchResponseFixture" },
    { "$ref": "#/$defs/PropertyResponseFixture" },
    { "$ref": "#/$defs/PermitResponseFixture" },
    { "$ref": "#/$defs/ErrorResponseFixture" }
  ],
  "$defs": {
    "ContractVersion": {
      "const": "1.0.0"
    },
    "SchemaHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[a-z]+_[a-f0-9]{32}$"
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "Derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "ruleVersion", "inputs"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "ruleVersion": { "type": "string", "minLength": 1 },
        "asOf": { "$ref": "#/$defs/IsoDateTime" },
        "inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "AvailableFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "value", "class", "evidenceRefs"],
      "properties": {
        "availability": { "const": "available" },
        "value": true,
        "class": {
          "enum": ["raw", "normalized", "derived", "inferred"]
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "derivation": { "$ref": "#/$defs/Derivation" }
      }
    },
    "UnavailableFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "value", "class", "reason", "evidenceRefs"],
      "properties": {
        "availability": { "const": "unavailable" },
        "value": { "type": "null" },
        "class": {
          "enum": ["raw", "normalized", "derived", "inferred"]
        },
        "reason": {
          "enum": [
            "not_provided_by_source",
            "source_not_collected",
            "source_unavailable",
            "not_applicable",
            "ambiguous_match"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "Fact": {
      "description": "The wrapper is strict. The value payload is intentionally field-specific and is constrained by the containing entity where needed.",
      "oneOf": [
        { "$ref": "#/$defs/AvailableFact" },
        { "$ref": "#/$defs/UnavailableFact" }
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceSystem",
        "sourceName",
        "sourceRecordKey",
        "sourceUrl",
        "sourceArtifactUri",
        "sourceRecordHash",
        "observedAt",
        "retrievedAt",
        "loadedAt",
        "publishedCid"
      ],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "sourceSystem": { "type": "string", "minLength": 1 },
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceRecordKey": { "type": "string", "minLength": 1 },
        "sourceUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "sourceArtifactUri": { "type": "string", "format": "uri" },
        "sourceRecordHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "observedAt": {
          "oneOf": [
            { "$ref": "#/$defs/IsoDateTime" },
            { "type": "null" }
          ]
        },
        "retrievedAt": { "$ref": "#/$defs/IsoDateTime" },
        "loadedAt": { "$ref": "#/$defs/IsoDateTime" },
        "publishedCid": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "Freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "retrievedAt",
        "loadedAt",
        "publishedAt",
        "computedAt",
        "sourceCadence",
        "cadenceStatus"
      ],
      "properties": {
        "observedAt": {
          "oneOf": [
            { "$ref": "#/$defs/IsoDateTime" },
            { "type": "null" }
          ]
        },
        "retrievedAt": { "$ref": "#/$defs/IsoDateTime" },
        "loadedAt": { "$ref": "#/$defs/IsoDateTime" },
        "publishedAt": {
          "oneOf": [
            { "$ref": "#/$defs/IsoDateTime" },
            { "type": "null" }
          ]
        },
        "computedAt": { "$ref": "#/$defs/IsoDateTime" },
        "sourceCadence": { "type": ["string", "null"] },
        "cadenceStatus": {
          "enum": [
            "within_source_cadence",
            "past_source_cadence",
            "cadence_unknown"
          ]
        }
      }
    },
    "Coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "crs"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "crs": { "const": "EPSG:4326" }
      }
    },
    "RoofAgeSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ageYears", "precision", "basis", "basisQuality", "asOf"],
      "properties": {
        "ageYears": { "type": "integer", "minimum": 0, "maximum": 500 },
        "precision": { "enum": ["day", "year"] },
        "basis": {
          "enum": [
            "roof_installation_date",
            "roof_permit_completion",
            "final_inspection",
            "roof_permit_issue",
            "year_built_proxy"
          ]
        },
        "basisQuality": { "enum": ["direct", "proxy"] },
        "asOf": { "$ref": "#/$defs/IsoDateTime" }
      }
    },
    "Permit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitId",
        "propertyId",
        "permitNumber",
        "status",
        "isOpen",
        "openDurationDays",
        "roofingRelevance",
        "contractor",
        "bbbRating",
        "evidence",
        "freshness"
      ],
      "properties": {
        "permitId": { "$ref": "#/$defs/Identifier" },
        "propertyId": { "$ref": "#/$defs/Identifier" },
        "permitNumber": { "$ref": "#/$defs/Fact" },
        "status": { "$ref": "#/$defs/Fact" },
        "isOpen": { "$ref": "#/$defs/Fact" },
        "openDurationDays": { "$ref": "#/$defs/Fact" },
        "roofingRelevance": { "$ref": "#/$defs/Fact" },
        "contractor": { "$ref": "#/$defs/Fact" },
        "bbbRating": { "$ref": "#/$defs/Fact" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/Evidence" },
          "minItems": 1
        },
        "freshness": { "$ref": "#/$defs/Freshness" }
      }
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propertyId",
        "county",
        "folio",
        "address",
        "coordinates",
        "yearBuilt",
        "roofInstallationDate",
        "roofAgeSignal",
        "ownershipDurationYears",
        "ownerArea",
        "openRoofingPermitCount",
        "maximumOpenRoofingPermitDays",
        "permits",
        "evidence",
        "freshness"
      ],
      "properties": {
        "propertyId": { "$ref": "#/$defs/Identifier" },
        "county": { "const": "pasco" },
        "folio": { "$ref": "#/$defs/Fact" },
        "address": { "$ref": "#/$defs/Fact" },
        "coordinates": { "$ref": "#/$defs/Fact" },
        "yearBuilt": { "$ref": "#/$defs/Fact" },
        "roofInstallationDate": { "$ref": "#/$defs/Fact" },
        "roofAgeSignal": { "$ref": "#/$defs/Fact" },
        "ownershipDurationYears": { "$ref": "#/$defs/Fact" },
        "ownerArea": { "$ref": "#/$defs/Fact" },
        "openRoofingPermitCount": { "$ref": "#/$defs/Fact" },
        "maximumOpenRoofingPermitDays": { "$ref": "#/$defs/Fact" },
        "permits": {
          "type": "array",
          "items": { "$ref": "#/$defs/Permit" },
          "maxItems": 100
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/Evidence" },
          "minItems": 1
        },
        "freshness": { "$ref": "#/$defs/Freshness" }
      }
    },
    "ResponseMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "schemaHash",
        "county",
        "asOf",
        "artifactCids",
        "nextCursor"
      ],
      "properties": {
        "contractVersion": { "$ref": "#/$defs/ContractVersion" },
        "schemaHash": { "$ref": "#/$defs/SchemaHash" },
        "county": { "const": "pasco" },
        "asOf": { "$ref": "#/$defs/IsoDateTime" },
        "artifactCids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "nextCursor": { "type": ["string", "null"] }
      }
    },
    "SearchArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["county", "center", "radius", "filters", "sort", "page"],
      "properties": {
        "county": { "const": "pasco" },
        "center": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "latitude", "longitude"],
              "properties": {
                "kind": { "const": "coordinates" },
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "text"],
              "properties": {
                "kind": { "const": "place" },
                "text": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          ]
        },
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "enum": ["mi", "km"] }
          },
          "allOf": [
            {
              "if": { "properties": { "unit": { "const": "mi" } } },
              "then": { "properties": { "value": { "maximum": 50 } } }
            },
            {
              "if": { "properties": { "unit": { "const": "km" } } },
              "then": { "properties": { "value": { "maximum": 80.4672 } } }
            }
          ]
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roofAge": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operator", "years", "basis"],
              "properties": {
                "operator": { "enum": ["gt", "gte"] },
                "years": { "type": "integer", "minimum": 0, "maximum": 100 },
                "basis": { "enum": ["direct_only", "direct_or_proxy"] }
              }
            },
            "permit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "roofingOnly": { "type": "boolean" },
                "openOnly": { "type": "boolean" },
                "minOpenDays": { "type": "integer", "minimum": 0, "maximum": 36500 }
              }
            },
            "ownership": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operator": { "enum": ["gt", "gte"] },
                "years": { "type": "integer", "minimum": 0, "maximum": 500 },
                "ownerArea": {
                  "enum": ["any", "out_of_county", "out_of_state"]
                }
              }
            },
            "freshness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "observedAtOrAfter": { "$ref": "#/$defs/IsoDateTime" },
                "publishedAtOrAfter": { "$ref": "#/$defs/IsoDateTime" }
              }
            },
            "matchMode": { "enum": ["all", "any"] }
          }
        },
        "sort": {
          "enum": ["distance_asc", "roof_age_desc", "permit_open_days_desc"]
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit"],
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
            "cursor": { "type": "string", "minLength": 1 }
          }
        },
        "asOf": { "$ref": "#/$defs/IsoDateTime" }
      }
    },
    "SearchRequestFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureType", "tool", "arguments"],
      "properties": {
        "fixtureType": { "const": "search-request" },
        "tool": { "const": "prism_v1_search_roofing_opportunities" },
        "arguments": { "$ref": "#/$defs/SearchArguments" }
      }
    },
    "SearchResponseFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureType", "tool", "result"],
      "properties": {
        "fixtureType": { "const": "search-response" },
        "tool": { "const": "prism_v1_search_roofing_opportunities" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "data", "meta"],
          "properties": {
            "ok": { "const": true },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["resolvedCenter", "opportunities"],
              "properties": {
                "resolvedCenter": { "$ref": "#/$defs/Fact" },
                "opportunities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["property", "distanceMeters", "matchReasons"],
                    "properties": {
                      "property": { "$ref": "#/$defs/Property" },
                      "distanceMeters": { "$ref": "#/$defs/Fact" },
                      "matchReasons": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "roof_age",
                            "open_roofing_permit",
                            "ownership_duration",
                            "owner_area"
                          ]
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      }
                    }
                  }
                }
              }
            },
            "meta": { "$ref": "#/$defs/ResponseMeta" }
          }
        }
      }
    },
    "PropertyResponseFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureType", "tool", "result"],
      "properties": {
        "fixtureType": { "const": "property-response" },
        "tool": { "const": "prism_v1_get_property" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "data", "meta"],
          "properties": {
            "ok": { "const": true },
            "data": { "$ref": "#/$defs/Property" },
            "meta": { "$ref": "#/$defs/ResponseMeta" }
          }
        }
      }
    },
    "PermitResponseFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureType", "tool", "result"],
      "properties": {
        "fixtureType": { "const": "permit-response" },
        "tool": { "const": "prism_v1_get_permit" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "data", "meta"],
          "properties": {
            "ok": { "const": true },
            "data": { "$ref": "#/$defs/Permit" },
            "meta": { "$ref": "#/$defs/ResponseMeta" }
          }
        }
      }
    },
    "ErrorResponseFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureType", "tool", "result"],
      "properties": {
        "fixtureType": { "const": "error-response" },
        "tool": {
          "enum": [
            "prism_v1_get_service_info",
            "prism_v1_get_pipeline_run_summary",
            "prism_v1_search_roofing_opportunities",
            "prism_v1_get_property",
            "prism_v1_get_permit",
            "prism_v1_get_query_schema"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "error", "meta"],
          "properties": {
            "ok": { "const": false },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "retryable"],
              "properties": {
                "code": {
                  "enum": [
                    "invalid_argument",
                    "invalid_cursor",
                    "not_found",
                    "county_not_served",
                    "data_unavailable",
                    "dependency_unavailable",
                    "rate_limited",
                    "deadline_exceeded",
                    "internal"
                  ]
                },
                "message": { "type": "string", "minLength": 1 },
                "retryable": { "type": "boolean" },
                "dependency": { "type": "string", "minLength": 1 },
                "details": {
                  "description": "Deliberately extensible, non-secret diagnostic fields for the selected error code.",
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "meta": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contractVersion", "schemaHash", "requestId"],
              "properties": {
                "contractVersion": { "$ref": "#/$defs/ContractVersion" },
                "schemaHash": { "$ref": "#/$defs/SchemaHash" },
                "requestId": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
