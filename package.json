{
  "name": "prism-pasco-oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node --watch --import tsx services/app.ts",
    "start": "node --import tsx services/app.ts",
    "format": "prettier --write \"services/**/*.ts\" \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" docker-compose.yml package.json tsconfig.json docs/foundation.md",
    "format:check": "prettier --check \"services/**/*.ts\" \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" docker-compose.yml package.json tsconfig.json docs/foundation.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit && vitest run tests/contracts",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "contracts:validate": "node --import tsx scripts/validate-contracts.ts",
    "health:check": "node --import tsx scripts/check-health.ts"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "1.16.9",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "17.4.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@restatedev/restate": "1.7.2",
    "@types/node": "22.20.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
