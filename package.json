{
  "name": "prism-pasco-oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node --watch --import tsx services/app.ts",
    "start": "node --import tsx services/app.ts",
    "format": "prettier --write \"services/**/*.ts\" \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"config/**/*.json\" docker-compose.yml eslint.config.js package.json tsconfig.json",
    "format:check": "prettier --check \"services/**/*.ts\" \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"config/**/*.json\" docker-compose.yml eslint.config.js package.json tsconfig.json",
    "lint": "eslint --max-warnings 0 \"services/**/*.ts\" \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit && vitest run tests/contracts",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "contracts:validate": "node --import tsx scripts/validate-contracts.ts",
    "health:check": "node --import tsx scripts/check-health.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "sources:acquire": "node --import tsx scripts/acquire-sources.ts",
    "pilot:run": "node --import tsx scripts/run-pilot.ts",
    "pilot:report": "node --import tsx scripts/pilot-report.ts",
    "pilot:check": "node --import tsx scripts/check-pilot.ts"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "1.16.9",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "postgres": "3.4.9",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@restatedev/restate": "1.7.2",
    "@types/node": "22.20.1",
    "@types/unzipper": "0.10.11",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
