# DATA_DIR must be an absolute host path. Do not point it at a sibling repository.
DATA_DIR=/absolute/path/to/oracle-property-intelligence-platform-pipeline-pasco-fl/data
DATABASE_URL=postgresql://postgres:elephant@localhost:5433/elephant
SERVICE_PORT=9080
RESTATE_ADMIN_URL=http://localhost:9070
RESTATE_INGRESS_URL=http://localhost:8080

# Development/test-only MCP provider. Paths may be absolute or relative to DATA_DIR,
# but must resolve to the same validated publication set below DATA_DIR.
ORACLE_MCP_PROVIDER=local-artifact
MCP_LOCAL_MANIFEST_PATH=artifacts/publish/pasco/dry-run-<run-id>/open-data/manifest.json
MCP_LOCAL_PARQUET_PATH=artifacts/publish/pasco/dry-run-<run-id>/query/query-tables/pasco/query-table.parquet
MCP_PORT=9090
MCP_REQUEST_TIMEOUT_MS=10000
MCP_MAX_REQUEST_BYTES=65536
MCP_MAX_RESPONSE_BYTES=2097152

# Production must use public-ipns and provide a fully hash-bound publication.
# Local-artifact mode is rejected in production; these values are intentionally
# inert and must be replaced together from one validated publication plan.
MCP_OPEN_DATA_IPNS=k51-example-open-data-publication
MCP_QUERY_TABLE_IPNS=k51-example-query-table-publication
MCP_PUBLIC_OPEN_DATA_ROOT_CID=Qm-example-open-data-root
MCP_PUBLIC_QUERY_TABLE_ROOT_CID=Qm-example-query-table-root
MCP_PUBLIC_MANIFEST_CID=Qm-example-manifest
MCP_PUBLIC_MANIFEST_SHA256=replace-with-64-lowercase-hex-characters
MCP_PUBLIC_PLAN_CID=Qm-example-publication-plan
MCP_PUBLIC_PLAN_SHA256=replace-with-64-lowercase-hex-characters
MCP_PUBLIC_TRANSPORT_TIMEOUT_MS=5000
MCP_PUBLIC_MAX_CACHE_AGE_SECONDS=300
MCP_PUBLIC_MAX_JSON_OBJECT_BYTES=8388608
MCP_PUBLIC_MAX_PARQUET_BYTES=134217728
MCP_PUBLIC_MAX_REDIRECTS=2
MCP_PUBLIC_RETRIES=1

# Candidate-owned demonstration publisher. It is disabled unless the switch is
# exactly true and every candidate-prefixed resource, hard limit and credential
# is supplied. Never reuse owner/canonical publication targets here.
CANDIDATE_DEMO_REMOTE_EXECUTOR_ENABLED=false
CANDIDATE_DEMO_FILEBASE_S3_ENDPOINT=https://s3.filebase.com
CANDIDATE_DEMO_FILEBASE_API_ENDPOINT=https://api.filebase.io
CANDIDATE_DEMO_FILEBASE_ACCESS_KEY_ID=replace-in-secret-store
CANDIDATE_DEMO_FILEBASE_SECRET_ACCESS_KEY=replace-in-secret-store
CANDIDATE_DEMO_FILEBASE_API_TOKEN=replace-in-secret-store
CANDIDATE_DEMO_OPEN_DATA_BUCKET=candidate-unique-open-data-bucket
CANDIDATE_DEMO_QUERY_TABLE_BUCKET=candidate-unique-query-table-bucket
CANDIDATE_DEMO_OPEN_DATA_IPNS_LABEL=candidate-unique-open-data-label
CANDIDATE_DEMO_QUERY_TABLE_IPNS_LABEL=candidate-unique-query-table-label
CANDIDATE_DEMO_OPEN_DATA_IPNS_NETWORK_KEY=k51-replace-with-public-network-key
CANDIDATE_DEMO_QUERY_TABLE_IPNS_NETWORK_KEY=k51-replace-with-public-network-key
CANDIDATE_DEMO_MAX_OBJECTS=30000
CANDIDATE_DEMO_MAX_TOTAL_BYTES=2147483648
CANDIDATE_DEMO_MAX_OBJECT_BYTES=536870912
CANDIDATE_DEMO_MAX_CONCURRENCY=4
CANDIDATE_DEMO_MAX_RETRIES=2
CANDIDATE_DEMO_REQUEST_TIMEOUT_MS=10000
CANDIDATE_DEMO_MAX_REQUESTS=100000
CANDIDATE_DEMO_MAX_BUDGET_USD=25
CANDIDATE_DEMO_STORAGE_USD_PER_GIB=replace-with-current-account-rate
CANDIDATE_DEMO_REQUEST_USD_PER_1000=replace-with-current-account-rate
